###############################################################################
### RETIRED: DISABLE THE OLD SMS QUEUE SCHEDULER IN /SYSTEM/SCHEDULER         ###
### THE CONTAINER WORKER NOW HANDLES ALL SENDING AND OUTGOING LIMITS         ###
###############################################################################

# This script deliberately does not send or erase sms_queue.txt. Old records
# have no reliable age or delivery status; review them before submitting again.
# Leaving the old /tool sms send script installed would bypass the new limits.
# Log once per router boot if this replacement is accidentally still scheduled.
:global smsGatewaySchedulerNotice
:if ($smsGatewaySchedulerNotice != true) do={
    :log warning "SMS queue scheduler retired: disable this scheduler. The container now sends queued SMS."
    :set smsGatewaySchedulerNotice true
}
