################################################################
### SCHEDULE THIS SCRIPT EVERY MINUTE TO CHECK THE SMS QUEUE ###
################################################################

:global filename "sms_queue.txt"

# Check whether the queue file exists
:if ([/file find name=$filename] != "") do={
  :global content [/file get $filename contents]
  :global contentLen [:len $content]

  :global lineEnd 0
  :global line ""
  :global lastEnd 0
  :global newContent ""

  # Read the queue one line at a time
  :while ($lastEnd < $contentLen) do={
    # Search for LF; this supports both LF and CRLF queue files
    :set lineEnd [:find $content "\n" $lastEnd]

    # If there is no next line break, use the end of the file
    :if ([:typeof $lineEnd] = "nil") do={
      :set lineEnd $contentLen
    }

    # Get the current line between the previous and next line break
    :set line [:pick $content $lastEnd $lineEnd]

    # Remove the remaining CR when the file uses CRLF
    :if (([:len $line] > 0) && ([:pick $line ([:len $line] - 1) [:len $line]] = "\r")) do={
      :set line [:pick $line 0 ([:len $line] - 1)]
    }

    # :log info ("Processing line starting at character " . $lastEnd . " with length " . ($lineEnd - $lastEnd))
    # :log info ("ContentLength " . $contentLen . "   LineEnd " . $lineEnd . "   LastEnd". $lastEnd)
	 
    :set lastEnd ($lineEnd + 1)

    # Process non-empty lines
    :if ($line != "") do={
      # Find the tab between the phone number and message
      :global parts [:find $line "\t"]
      
      # Continue only when a tab was found
      :if ([:len $parts] > 0) do={
        :global phoneNumber [:pick $line 0 $parts]
        :global message [:pick $line ($parts + 1) [:len $line]]

        :log info ("Sending SMS to " . $phoneNumber . " with message: " . $message)

        :global success false

        :do {
          /tool sms send port=lte1 phone-number=$phoneNumber message=$message
          :set success true
          :delay 5s; # Wait before sending the next SMS
        } on-error={
          :log error ("Error sending SMS to " . $phoneNumber)
        }

        # Keep failed messages in the queue for the next run
        :if ($success = false) do={
          # Add LF only between failed records
          :if ([:len $newContent] > 0) do={
            :set newContent ($newContent . "\n")
          }
          :set newContent ($newContent . $line)
        }
      }
    }
  }

  # Replace the old queue with the messages that still failed
  /file set [find name=$filename] contents=$newContent
}
